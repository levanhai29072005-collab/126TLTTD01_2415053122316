<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/tvThongTinSV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lê Văn Hải - 2415053122316\nBài: W01A- Sổ HỌC Phần"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:paddingBottom="16dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên Học Phần:"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/edtTenHocPhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập Tên Học Phần"
            android:inputType="textCapWords"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Điểm quá Trình:"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/edtDiemQT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập Điểm (0..10)"
            android:inputType="numberDecimal"
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Điểm Cuối Kì (CK) :"
                android:textStyle="bold"/>
        <EditText
            android:id="@+id/edtDiemCK"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập Điểm CK(0..10)"
            android:inputType="numberDecimal"/>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:orientation="horizontal">
    <Button
        android:id="@+id/btnKiemTra"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:text="Kiểm Tra"/>
    <Button
        android:id="@+id/btnXoa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:backgroundTint="#757575"
        android:text="Xóa"/>
</LinearLayout>
        <TextView
            android:id="@+id/tvKetQua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="F5F5F5"
            android:padding="16dp"
            android:text="Chưa có kết quả"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>
</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>